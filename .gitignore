# Subprojects — these have their own git repositories
splash/
corpus/
_generated/

# tools/ is a separately-cloned standalone repo (https://github.com/tolstoylife/tools); kept out of the parent
tools

# Production projects — each has its own git repo
# bethink-yourselves, birukoff-biography, korrektur
projects/

# Large binary source files
primary-sources/

# Internal working folders — not tracked
_design/
_docs/
_resources/
__backup/
__scrap

# Obsidian internals
.obsidian/

# Local config — .claude/skills/ is excepted (project skills are shared assets)
.claude/*
!.claude/skills
.omc/
.superpowers/
.python-version
.vault-nickname

# macOS
.DS_Store

# Standard build/runtime/env patterns (kept here as a safety net even though
# subprojects also ignore them — gitignore-audit.py expects these at root).
node_modules
_site
dist
__pycache__/
*.pyc
.env
.env.local

# Temporary files
*.tmp
*.skill
ziYV7S8m
/lightrag.log
