      "type": "Annotation"
    },
    {
      "@context": "http://www.w3.org/ns/anno.jsonld",
      "body": {
        "color": "yellow",
        "format": "text/plain",
        "highlight": "solid",
        "tag": "",
        "type": "TextualBody",
        "value": "The solution of Henry George is often labelled as \"Single tax\" but he keeps repeating the same words as T about faith and religion as the means to remove landed property."
      },
      "created": "2026-07-03T07:40:53.745Z",
      "creator": {
        "id": "urn:uuid:6e361bcc-b557-40b5-b910-0955ff3c6531",
        "name": "",
        "type": "Organization"
      },
      "id": "urn:uuid:67faa4aa-d1cb-431b-944e-9b7b60667e6d",
      "motivation": "highlighting",
      "target": {
        "meta": {
          "headings": [
            {
              "level": 2,
              "txt": "Part IX"
            }
          ]
        },
        "selector": [
          {
            "refinedBy": {
              "end": 114,
              "start": 2,
              "type": "TextPositionSelector"
            },
            "type": "CssSelector",
            "value": "#p-10-13"
          },
          {
            "end": 6565,
            "start": 6453,
            "type": "TextPositionSelector"
          },
          {
            "exact": "he ground is plowed; the seed is set; the good tree will grow. So little now; only the eye of faith can see it.\"",
            "prefix": "\"T",
            "suffix": "",
            "type": "TextQuoteSelector"
          },
          {
            "type": "ProgressionSelector",
            "value": 0.8035898158221946
          },
          {
