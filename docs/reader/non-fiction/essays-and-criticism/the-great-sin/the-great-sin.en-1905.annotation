          },
          {
            "end": 6661,
            "start": 6566,
            "type": "TextPositionSelector"
          },
          {
            "exact": "And I think that Henry George is right, that the removal of the sin of landed property is near,",
            "prefix": "",
            "suffix": "",
            "type": "TextQuoteSelector"
          },
          {
            "type": "ProgressionSelector",
            "value": 0.8218643145788002
          },
          {
