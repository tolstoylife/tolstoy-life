    {
      "@context": "http://www.w3.org/ns/anno.jsonld",
      "body": {
        "color": "yellow",
        "format": "text/plain",
        "highlight": "solid",
        "tag": "",
        "type": "TextualBody",
        "value": "The definition of Religion from T should not be confused with neither the academic nor theological explanation."
      },
      "created": "2026-07-03T07:07:46.265Z",
      "creator": {
        "id": "urn:uuid:6e361bcc-b557-40b5-b910-0955ff3c6531",
        "name": "",
        "type": "Organization"
      },
      "id": "urn:uuid:1d291657-2244-4e76-b7c7-f1fca11be0af",
      "motivation": "highlighting",
      "target": {
        "meta": {
          "headings": [
            {
              "level": 2,
              "txt": "Part VII"
