            "type": "FragmentSelector",
            "value": "epubcfi(/6/22!/4/2/28[p-10-13],/2[p-10-13-s1]/1:2,/4[p-10-13-s2]/1:49)"
          },
          {
            "type": "CfiSelector",
            "value": "/4/2/28[p-10-13],/2[p-10-13-s1]/1:2,/4[p-10-13-s2]/1:49"
