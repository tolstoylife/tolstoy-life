  "items": [
    {
      "@context": "http://www.w3.org/ns/anno.jsonld",
      "body": {
        "color": "yellow",
        "format": "text/plain",
        "highlight": "solid",
        "tag": "",
        "type": "TextualBody",
        "value": "Here's why the new title A great iniquity is very bad: \"iniquity\" resides in a system of money and ownership and governments. \"Sin\" an is a religious word, so changing The great sin is completely reverring the perspective. Also notice how \"A\" instead of \"The\" is softening the stance.\n\nWe need to investigate what influence the editor of The London Times had on T/Chertkov, if any."
      },
      "created": "2026-07-03T07:47:06.782Z",
      "creator": {
        "id": "urn:uuid:6e361bcc-b557-40b5-b910-0955ff3c6531",
        "name": "",
        "type": "Organization"
      },
      "id": "urn:uuid:32ad70dd-389b-466d-9f87-0eaf7cc9446f",
      "motivation": "highlighting",
      "target": {
